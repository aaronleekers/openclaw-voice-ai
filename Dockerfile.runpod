# RunPod Dockerfile for Twilio Voice AI + PersonaPlex
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y \
    git \
    wget \
    libsndfile1 \
    ffmpeg \
    espeak \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --no-cache-dir \
    torch==2.1.0 \
    torchaudio==2.1.0 \
    flask==3.0.0 \
    flask-cors==4.0.0 \
    twilio==9.0.0 \
    python-dotenv==1.0.0 \
    edge-tts \
    transformers \
    accelerate \
    gradio

# Copy app files
COPY . /app/

# Expose ports
EXPOSE 5001 8000

# Start both servers
CMD ["python", "runpod_server.py"]
